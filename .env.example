# Kopiera till .env och fyll i vid behov. Allting fungerar utan AI-nycklar (lokalt läge).

# Server
PORT=8787
NODE_ENV=development
# DATA_DIR=./data
# DB_PATH=./data/mordgatan.sqlite

# AI-leverantätt (valfritt). 'local' är standard och kräver inga nycklar.
# Välj 'openai-compatible' för en OpenAI-kompatibel chat completions-endpoint.
AI_PROVIDER=local
# AI_BASE_URL=https://api.exempel.se/v1
# AI_MODEL=min-modell
# AI_API_KEY=xxxx
# AI_TIMEOUT_MS=12000

# Timkvoter för kostnadskontroll. När taket nås fallback:ar systemet till lokala motorn.
AI_HOUR_BUDGET=60
AI_ROOM_HOUR_BUDGET=200
