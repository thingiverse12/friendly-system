# Sparly runtime configuration (Supabase Auth + Supabase Postgres).
# Copy to .env and load it with your process manager, Vercel environment variables, or
#   set -a; . ./.env; set +a

# ---------------------------------------------------------------- HTTP
PORT=3000
HOST=0.0.0.0

# ---------------------------------------------------------------- Database
# Supabase Postgres. Use the *transaction pooler* (port 6543) on serverless hosts such as Vercel;
# the direct host (db.<ref>.supabase.co) is IPv6-only and will not resolve from most serverless
# runtimes. The username is postgres.<project-ref>.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
# DATABASE_SSL=1
# DATABASE_POOL_SIZE=3
#
# Without DATABASE_URL the server uses PGlite in PGLITE_DIR (real Postgres semantics in WebAssembly).
# PGLITE_DIR=./data/pglite

# ---------------------------------------------------------------- Supabase Auth
# The browser signs in directly against Supabase; this server only verifies the resulting access
# token (GET /auth/v1/user) and deletes the Auth user when an account is erased.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=<anon key>
# SUPABASE_SERVICE_ROLE_KEY=<service_role key>   # server-side only, never expose it to the browser

# ---------------------------------------------------------------- Frontend (read at BUILD time)
# Baked into the SPA by Vite. Only the public anon key belongs here.
# VITE_SUPABASE_URL=https://<ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon key>

# ---------------------------------------------------------------- Cookies & sessions
# Set to 1 when the app is served over HTTPS (required in production).
COOKIE_SECURE=1
# Session lifetime in hours (server-side sessions are validated on every request).
SESSION_TTL_HOURS=336
# Cookie SameSite policy: Lax (recommended), Strict, or None (Secure only - needed when the app is
# embedded in a cross-site iframe such as a preview panel).
COOKIE_SAMESITE=Lax

# Extra browser origins allowed to call the API, comma separated
# (same-origin requests and the platform preview host are always allowed).
# ALLOWED_ORIGINS=https://sparly.example.com

# Trust the reverse proxy for client IPs (rate limiting) - set 1 on Vercel, nginx or an ALB.
TRUST_PROXY=1

# Never enable outside automated tests: allows the test suite to freeze server time.
# SPARLY_ALLOW_CLOCK_OVERRIDE=0
