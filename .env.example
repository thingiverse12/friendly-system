# Sparly runtime configuration. Copy to .env (loaded by your process manager) and adjust.

# HTTP
PORT=3000
HOST=0.0.0.0

# Persistent SQLite database file. Always put it on a durable volume.
DATABASE_FILE=./data/sparly.db

# Set to 1 when the app is served over HTTPS (required in production).
# Keep at 0 only for local plain-HTTP development.
COOKIE_SECURE=1

# Session lifetime in hours (server-side sessions are validated on every request).
SESSION_TTL_HOURS=336

# Cookie SameSite policy: Lax (recommended), Strict, or None (Secure only - needed when the app is
# embedded in a cross-site iframe such as a preview panel).
COOKIE_SAMESITE=Lax

# Extra browser origins allowed to call the API, comma separated
# (same-origin requests and the platform preview host are always allowed).
# ALLOWED_ORIGINS=https://sparly.example.com

# Trust the reverse proxy for client IPs (rate limiting) - usually 1 behind nginx/ALB.
TRUST_PROXY=1

# Never enable outside automated tests: allows the test suite to freeze server time.
# SPARLY_ALLOW_CLOCK_OVERRIDE=0
