{
  "name": "sparly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sparly – standalone savings app with goals, achievements and competitions",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build:web && npm run start",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node dist/index.js",
    "start:dev-runtime": "NODE_ENV=production node dist/index.js",
    "typecheck": "npm run typecheck:server && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "check:schema": "tsx scripts/check-schema.mts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@supabase/supabase-js": "^2.118.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.1.0",
    "jose": "^6.2.13",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.9",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.5"
  }
}
