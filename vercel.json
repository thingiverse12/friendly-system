{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "installCommand": "npm ci",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 30,
      "memory": 1024,
      "excludeFiles": "{node_modules/@electric-sql/**/*,node_modules/@node-rs/**/*,data/**/*,web/src/**/*}"
    },
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024,
      "excludeFiles": "{node_modules/@electric-sql/**/*,node_modules/@node-rs/**/*,data/**/*,web/src/**/*}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path].js"
    },
    {
      "source": "/((?!api/|assets/|favicon\\.ico|favicon\\.svg|icons/|manifest\\.webmanifest|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
